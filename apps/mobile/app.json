{
  "expo": {
    "name": "VAANJAY",
    "slug": "vaanjay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "vaanjay",
    "splash": {
      "image": "./src/assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vaanjay.app",
      "infoPlist": {
        "NSCameraUsageDescription": "VAANJAY needs camera access to take photos and record videos",
        "NSMicrophoneUsageDescription": "VAANJAY needs microphone access for video recording and calls",
        "NSPhotoLibraryUsageDescription": "VAANJAY needs photo library access to upload media"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.vaanjay.app",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      "expo-camera",
      "expo-image-picker",
      "@react-native-firebase/app",
      "react-native-vision-camera"
    ]
  }
}
